# Copy this file to .env and fill in your key:
#   cp env.example .env

# --- Required ---------------------------------------------------------------
# LLM provider: openai (default) or anthropic
QA_PROVIDER=openai
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Only needed if QA_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# --- Test data: use in steps as {{env:NAME}} ---------------------------------
# Names containing PASS / SECRET / TOKEN / KEY / PIN / OTP are masked before
# anything is sent to the LLM; the real value is only typed into the browser.
TEST_USER=demo@example.com
TEST_PASSWORD=demo1234

# --- Optional ---------------------------------------------------------------
# Defaults: openai -> gpt-5.5 / gpt-5.4-mini, anthropic -> claude-sonnet-5-5 / claude-haiku-4-5
# QA_MODEL=openai:gpt-5.5                        # planner, generator, AI review
# QA_VERIFIER_MODEL=openai:gpt-5.4-mini          # cheap model that checks each step
# QA_HEADLESS=true                               # false = also open a visible browser window
# QA_MAX_SUB_ACTIONS=8                           # agent turns per step
# QA_MAX_ATTEMPTS=3                              # consecutive failed actions before a step fails
# QA_STEP_TIMEOUT_S=120
# QA_MAX_CONCURRENT_RUNS=2

# TestTeller generator reuses OPENAI_API_KEY (LLM + embeddings); run `testteller configure` once.
