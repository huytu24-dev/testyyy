{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/bin/uvicorn",
      "runtimeArgs": ["--app-dir", "backend", "app.main:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "backend-scripted",
      "runtimeExecutable": "backend/.venv/bin/python",
      "runtimeArgs": ["backend/tests/scripted_server.py"],
      "port": 8000
    },
    {
      "name": "demo-app",
      "runtimeExecutable": "backend/.venv/bin/uvicorn",
      "runtimeArgs": ["demo_app.server:app", "--port", "8001"],
      "port": 8001
    },
    {
      "name": "ui",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    }
  ]
}
